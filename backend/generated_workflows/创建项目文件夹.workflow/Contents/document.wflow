                                <key>ActionBundlePath</key>
                                <string>/System/Library/Automator/Run AppleScript.action</string>
                                <key>ActionName</key>
                                <string>运行AppleScript</string>
                                <key>ActionParameters</key>
                                <dict>
                                        <key>source</key>
                                        <string>        tell application "Finder"
            set selectedItems to selection
            if selectedItems is not {} then
                set selectedItem to item 1 of selectedItems
                if class of selectedItem is folder then
                    set selectedFolder to selectedItem
                else
                    set selectedFolder to container of selectedItem
                end if
            else
                set selectedFolder to target of front Finder window
            end if
            set selectedFolderPath to POSIX path of (selectedFolder as text)
            do shell script "mkdir -p " &amp; quoted form of (selectedFolderPath &amp; "/00筹备") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/01原始素材/其他素材") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/01原始素材/摄影机素材") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/01原始素材/网络素材-原始") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/02代理素材/网络素材-小样") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/03音频/VO") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/03音频/音乐") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/03音频/音效") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/04包装") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/05特效") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/06静帧") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/07输出") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/08交付") &amp; " " &amp; quoted form of (selectedFolderPath &amp; "/09工程文件")
        end tell</string>
                                </dict>
