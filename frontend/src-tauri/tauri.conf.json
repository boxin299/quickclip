{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuickClip",
  "version": "1.0.6",
  "identifier": "com.boxin299.quickclip",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bash scripts/dev-with-backend.sh",
    "beforeBuildCommand": "bash scripts/build-backend-runtime.sh && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' ipc: https://ipc.localhost; script-src 'self' 'unsafe-inline' ipc: https://ipc.localhost; connect-src 'self' ipc: https://ipc.localhost http://quickclip.top https://quickclip.top http://124.220.21.242 http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "backend-runtime/**/*"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.macOS.plist",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 141,
          "y": 250
        },
        "applicationFolderPosition": {
          "x": 360,
          "y": 250
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
